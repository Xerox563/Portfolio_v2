# ===== Required (copy to .env and fill with real values, never commit .env) =====

# PostgreSQL connection string (Vercel Storage / Neon / Supabase / any Postgres).
# The API uses this for all content + blog storage in production.
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Web3Forms public access key for the contact form (https://web3forms.com)
VITE_WEB3FORMS_KEY=paste-your-key-here

# Admin login (client-side check, used by /#admin)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=Itsme@portfolio

# Optional: full API URL if the API is hosted elsewhere (leave empty to use same origin)
VITE_API_URL=

# ===== Optional =====

# Set to 1 to re-seed the database from db.json / blogs.db on every deploy
# (overwrites any admin edits). Leave empty/0 to seed only once (first run).
RESEED_ON_DEPLOY=0

# Legacy Upstash Redis fallback (only used if DATABASE_URL is not set)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=